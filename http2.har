            "mimeType": "text/html",
            "text": "<!DOCTYPE html>\n<html lang=\"hr\">\n\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>HTTP/2 Performance Demo</title>\n    <link rel=\"stylesheet\" href=\"css/style1.css\">\n    <link rel=\"stylesheet\" href=\"css/style2.css\">\n    <link rel=\"stylesheet\" href=\"css/style3.css\">\n    <link rel=\"stylesheet\" href=\"css/style4.css\">\n    <link rel=\"stylesheet\" href=\"css/style5.css\">\n    <link rel=\"stylesheet\" href=\"css/style6.css\">\n    <link rel=\"stylesheet\" href=\"css/style7.css\">\n    <link rel=\"stylesheet\" href=\"css/style8.css\">\n    <link rel=\"stylesheet\" href=\"css/style9.css\">\n    <link rel=\"stylesheet\" href=\"css/style10.css\">\n    <script src=\"js/script1.js\" defer></script>\n    <script src=\"js/script2.js\" defer></script>\n    <script src=\"js/script3.js\" defer></script>\n    <script src=\"js/script4.js\" defer></script>\n    <script src=\"js/script5.js\" defer></script>\n    <script src=\"js/script6.js\" defer></script>\n    <script src=\"js/script7.js\" defer></script>\n    <script src=\"js/script8.js\" defer></script>\n    <script src=\"js/script9.js\" defer></script>\n    <script src=\"js/script10.js\" defer></script>\n</head>\n\n<body>\n    <header>\n        <h1>HTTP/2 vs. HTTP/1.x</h1>\n        <p>Demonstracija učitavanja višestrukih resursa</p>\n    </header>\n\n    <main>\n        <section class=\"gallery\">\n            <h2>Galerija slika</h2>\n            <div class=\"image-grid\">\n                <img src=\"images/image_1.png\" alt=\"Slika 1\">\n                <img src=\"images/image_2.png\" alt=\"Slika 2\">\n                <img src=\"images/image_3.png\" alt=\"Slika 3\">\n                <img src=\"images/image_4.png\" alt=\"Slika 4\">\n                <img src=\"images/image_5.png\" alt=\"Slika 5\">\n                <img src=\"images/image_6.jpg\" alt=\"Slika 6\">\n                <img src=\"images/image_7.jpg